                          <Style><BackgroundColor>#e2e8f0</BackgroundColor><Border><Color>#94a3b8</Color><Style>Solid</Style></Border></Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <!-- 12. Sum(MatrixAmount) -->
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Sum_MatrixAmount">
                          <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Sum(Fields!MatrixAmount.Value), "#,##0.00")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight><Color>#0f172a</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                          <Style><BackgroundColor>#e2e8f0</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom><Border><Color>#94a3b8</Color><Style>Solid</Style></Border></Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <!-- 13. Sum(Allowances) -->
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Sum_Allowances">
                          <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Sum(Fields!Conveyance.Value + Fields!Miscellaneous.Value + Fields!OtherAllowance.Value + Fields!IncentivePay.Value), "#,##0.00")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight><Color>#475569</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                          <Style><BackgroundColor>#e2e8f0</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom><Border><Color>#94a3b8</Color><Style>Solid</Style></Border></Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <!-- 14. Sum(TotalEarnings) -->
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Sum_TotalEarnings">
                          <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Sum(Fields!TotalEarnings.Value), "#,##0.00")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight><Color>#0f766e</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                          <Style><BackgroundColor>#ccfbf1</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom><Border><Color>#94a3b8</Color><Style>Solid</Style></Border></Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <!-- 15. Sum(ProfessionalTax) -->
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Sum_PTax">
                          <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Sum(Fields!ProfessionalTax.Value), "#,##0.00")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight><Color>#475569</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                          <Style><BackgroundColor>#e2e8f0</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom><Border><Color>#94a3b8</Color><Style>Solid</Style></Border></Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <!-- 16. Sum(LOPDeduction) -->
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Sum_LOPDed">
                          <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Sum(Fields!LOPDeduction.Value), "#,##0.00")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight><Color>#475569</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                          <Style><BackgroundColor>#e2e8f0</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom><Border><Color>#94a3b8</Color><Style>Solid</Style></Border></Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <!-- 17. Sum(OtherDed) -->
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Sum_OtherDed">
                          <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Sum(Fields!Deduction1.Value + Fields!Deduction2.Value + Fields!Deduction3.Value), "#,##0.00")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight><Color>#475569</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                          <Style><BackgroundColor>#e2e8f0</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom><Border><Color>#94a3b8</Color><Style>Solid</Style></Border></Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <!-- 18. Sum(TotalDeductions) -->
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Sum_TotalDeductions">
                          <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Sum(Fields!TotalDeductions.Value), "#,##0.00")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight><Color>#991b1b</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                          <Style><BackgroundColor>#fee2e2</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom><Border><Color>#94a3b8</Color><Style>Solid</Style></Border></Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <!-- 19. Sum(NetSalary) -->
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Sum_NetSalary">
                          <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Sum(Fields!NetSalary.Value), "#,##0.00")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>#1e40af</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                          <Style><BackgroundColor>#dbeafe</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom><Border><Color>#94a3b8</Color><Style>Solid</Style></Border></Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
