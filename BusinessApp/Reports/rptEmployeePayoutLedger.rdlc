                    <!-- 14. Total Earnings -->
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="TxtTotalEarnings">
                          <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Fields!TotalEarnings.Value, "#,##0.00")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight><Color>#0f766e</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                          <Style><BackgroundColor>=IIf(RowNumber(Nothing) Mod 2 = 0, "#f0fdfa", "#ffffff")</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom><Border><Color>#e2e8f0</Color><Style>Solid</Style></Border></Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <!-- 15. P.Tax -->
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="TxtPTax">
