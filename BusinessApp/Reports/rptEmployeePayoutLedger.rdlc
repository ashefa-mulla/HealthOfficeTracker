  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <!-- Report Header Banner -->
          <Textbox Name="TxtCompanyName">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>=First(Fields!CompanyName.Value, "EmployeePayoutLedger")</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>13pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <Color>#1e293b</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Center</TextAlign>
                </Style>
              </Paragraph>
            </Paragraphs>
            <Top>0.08in</Top>
            <Left>0in</Left>
            <Height>0.26in</Height>
            <Width>10.06in</Width>
            <Style>
              <Border>
                <Style>None</Style>
              </Border>
            </Style>
          </Textbox>

          <Textbox Name="TxtReportTitle">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>=Parameters!reportTitle.Value</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>10.5pt</FontSize>
                      <FontWeight>SemiBold</FontWeight>
                      <Color>#2563eb</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=" - " &amp; First(Fields!PaySlipMonth.Value, "EmployeePayoutLedger")</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>10.5pt</FontSize>
                      <FontWeight>SemiBold</FontWeight>
                      <Color>#475569</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Center</TextAlign>
                </Style>
              </Paragraph>
            </Paragraphs>
            <Top>0.35in</Top>
            <Left>0in</Left>
            <Height>0.22in</Height>
            <Width>10.06in</Width>
            <Style>
              <Border>
                <Style>None</Style>
              </Border>
            </Style>
          </Textbox>

          <!-- Main Payout Ledger Tablix (19 Columns, ID removed) -->
          <Tablix Name="TablixPayoutLedger">
