                          <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Fields!GrandTotalPoints.Value, "0.##")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>7pt</FontSize><Color>#334155</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                          <Style><BackgroundColor>=IIf(RowNumber(Nothing) Mod 2 = 0, "#f8fafc", "#ffffff")</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom><Border><Color>#e2e8f0</Color><Style>Solid</Style></Border></Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <!-- 12. Matrix Amount -->
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="TxtMatrixAmt">
                          <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Fields!MatrixAmount.Value, "#,##0.00")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>7pt</FontSize><Color>#0f172a</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                          <Style><BackgroundColor>=IIf(RowNumber(Nothing) Mod 2 = 0, "#f8fafc", "#ffffff")</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom><Border><Color>#e2e8f0</Color><Style>Solid</Style></Border></Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <!-- 13. Allowances -->
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="TxtAllowances">
                          <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Fields!Conveyance.Value + Fields!Miscellaneous.Value + Fields!OtherAllowance.Value + Fields!IncentivePay.Value, "#,##0.00")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>7pt</FontSize><Color>#475569</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                          <Style><BackgroundColor>=IIf(RowNumber(Nothing) Mod 2 = 0, "#f8fafc", "#ffffff")</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom><Border><Color>#e2e8f0</Color><Style>Solid</Style></Border></Style>
                        </Textbox>
                      </CellContents>
