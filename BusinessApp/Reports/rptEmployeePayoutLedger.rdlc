                          <Style><BackgroundColor>#1e40af</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>4pt</PaddingTop><PaddingBottom>4pt</PaddingBottom><Border><Color>#cbd5e1</Color><Style>Solid</Style></Border></Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>

                <!-- DATA ROW -->
                <TablixRow>
                  <Height>0.24in</Height>
                  <TablixCells>
                    <!-- 1. Row Index -->
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="TxtRowIndex">
                          <Paragraphs><Paragraph><TextRuns><TextRun><Value>=RowNumber(Nothing)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>7pt</FontSize><Color>#475569</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                          <Style><BackgroundColor>=IIf(RowNumber(Nothing) Mod 2 = 0, "#f8fafc", "#ffffff")</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom><Border><Color>#e2e8f0</Color><Style>Solid</Style></Border></Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <!-- 2. Employee Name -->
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="TxtEmpName">
