                <!-- 1. # -->
                <TablixColumn><Width>0.28in</Width></TablixColumn>
                <!-- 2. Employee Name -->
                <TablixColumn><Width>1.35in</Width></TablixColumn>
                <!-- 3. Designation -->
                <TablixColumn><Width>1.05in</Width></TablixColumn>
                <!-- 4. WD -->
                <TablixColumn><Width>0.30in</Width></TablixColumn>
                <!-- 5. Att -->
                <TablixColumn><Width>0.30in</Width></TablixColumn>
                <!-- 6. Leaves -->
                <TablixColumn><Width>0.36in</Width></TablixColumn>
                <!-- 7. Paid -->
                <TablixColumn><Width>0.33in</Width></TablixColumn>
                <!-- 8. LOP -->
                <TablixColumn><Width>0.33in</Width></TablixColumn>
                <!-- 9. Gross Wages -->
                <TablixColumn><Width>0.76in</Width></TablixColumn>
                <!-- 10. Matrix Rate -->
                <TablixColumn><Width>0.42in</Width></TablixColumn>
                <!-- 11. Points -->
                <TablixColumn><Width>0.34in</Width></TablixColumn>
                <!-- 12. Matrix Amount -->
                <TablixColumn><Width>0.66in</Width></TablixColumn>
                <!-- 13. Allowances -->
                <TablixColumn><Width>0.66in</Width></TablixColumn>
                <!-- 14. Total Earnings -->
                <TablixColumn><Width>0.80in</Width></TablixColumn>
                <!-- 15. P.Tax -->
                <TablixColumn><Width>0.45in</Width></TablixColumn>
                <!-- 16. LOP Ded -->
                <TablixColumn><Width>0.56in</Width></TablixColumn>
                <!-- 17. Other Ded -->
                <TablixColumn><Width>0.56in</Width></TablixColumn>
                <!-- 18. Total Ded -->
                <TablixColumn><Width>0.70in</Width></TablixColumn>
                <!-- 19. Net Salary -->
                <TablixColumn><Width>0.86in</Width></TablixColumn>
              </TablixColumns>
              <TablixRows>
                <!-- HEADER ROW -->
                <TablixRow>
                  <Height>0.36in</Height>
