                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <!-- 5. Att -->
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Tot_Att">
                          <Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns></Paragraph></Paragraphs>
                          <Style><BackgroundColor>#e2e8f0</BackgroundColor><Border><Color>#94a3b8</Color><Style>Solid</Style></Border></Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <!-- 6. Leaves -->
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Tot_Leaves">
                          <Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns></Paragraph></Paragraphs>
                          <Style><BackgroundColor>#e2e8f0</BackgroundColor><Border><Color>#94a3b8</Color><Style>Solid</Style></Border></Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <!-- 7. Paid -->
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Tot_Paid">
                          <Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns></Paragraph></Paragraphs>
                          <Style><BackgroundColor>#e2e8f0</BackgroundColor><Border><Color>#94a3b8</Color><Style>Solid</Style></Border></Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <!-- 8. LOP -> Total Label -->
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Lbl_Total">
                          <Paragraphs><Paragraph><TextRuns><TextRun><Value>Total</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight><Color>#1e293b</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                          <Style><BackgroundColor>#e2e8f0</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom><Border><Color>#94a3b8</Color><Style>Solid</Style></Border></Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <!-- 9. Sum(GrossWages) -->
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Sum_GrossWages">
                          <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Sum(Fields!GrossWages.Value), "#,##0.00")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight><Color>#0f172a</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                          <Style><BackgroundColor>#e2e8f0</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom><Border><Color>#94a3b8</Color><Style>Solid</Style></Border></Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <!-- 10. empty -->
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Tot_Empty1">
                          <Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns></Paragraph></Paragraphs>
