                          <Style><BackgroundColor>=IIf(RowNumber(Nothing) Mod 2 = 0, "#eff6ff", "#ffffff")</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom><Border><Color>#e2e8f0</Color><Style>Solid</Style></Border></Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>

                <!-- TOTAL SUMMARY FOOTER ROW (19 Columns) -->
                <TablixRow>
                  <Height>0.28in</Height>
                  <TablixCells>
                    <!-- 1. SrNo -->
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Tot_SrNo">
                          <Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns></Paragraph></Paragraphs>
                          <Style><BackgroundColor>#e2e8f0</BackgroundColor><Border><Color>#94a3b8</Color><Style>Solid</Style></Border></Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <!-- 2. EmpName -->
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Tot_EmpName">
                          <Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns></Paragraph></Paragraphs>
                          <Style><BackgroundColor>#e2e8f0</BackgroundColor><Border><Color>#94a3b8</Color><Style>Solid</Style></Border></Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <!-- 3. Designation -->
                    <TablixCell>
                      <CellContents>
