                          <Style><BackgroundColor>=IIf(RowNumber(Nothing) Mod 2 = 0, "#f8fafc", "#ffffff")</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom><Border><Color>#e2e8f0</Color><Style>Solid</Style></Border></Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <!-- 16. LOP Ded -->
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="TxtLOPDed">
                          <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Fields!LOPDeduction.Value, "#,##0.00")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>7pt</FontSize><Color>#475569</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                          <Style><BackgroundColor>=IIf(RowNumber(Nothing) Mod 2 = 0, "#f8fafc", "#ffffff")</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom><Border><Color>#e2e8f0</Color><Style>Solid</Style></Border></Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <!-- 17. Other Ded -->
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="TxtOtherDed">
                          <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Fields!Deduction1.Value + Fields!Deduction2.Value + Fields!Deduction3.Value, "#,##0.00")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>7pt</FontSize><Color>#475569</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                          <Style><BackgroundColor>=IIf(RowNumber(Nothing) Mod 2 = 0, "#f8fafc", "#ffffff")</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom><Border><Color>#e2e8f0</Color><Style>Solid</Style></Border></Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <!-- 18. Total Ded -->
                    <TablixCell>
                      <CellContents>
