  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Image Name="ImgLogo">
            <Source>External</Source>
            <Value>=IIf(Parameters!logoPath.Value &lt;&gt; "", Parameters!logoPath.Value, "FileServer/Logo/Small-VO-LOGO.png")</Value>
            <Sizing>FitProportional</Sizing>
            <Height>0.5in</Height>
            <Width>1.9in</Width>
            <Style>
              <Border>
                <Style>None</Style>
              </Border>
            </Style>
          </Image>
          <Textbox Name="TxtCompanyName">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>=IIf(First(Fields!CompanyName.Value, "EmployeePaySlip") &lt;&gt; "", First(Fields!CompanyName.Value, "EmployeePaySlip"), "Virtual Office")</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>11pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <Color>#0f172a</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>=Trim(IIf(IsNothing(First(Fields!AddressLine1.Value, "EmployeePaySlip")), "", First(Fields!AddressLine1.Value, "EmployeePaySlip")) &amp; " " &amp; IIf(IsNothing(First(Fields!AddressLine2.Value, "EmployeePaySlip")), "", First(Fields!AddressLine2.Value, "EmployeePaySlip")) &amp; IIf(IsNothing(First(Fields!City.Value, "EmployeePaySlip")) Or First(Fields!City.Value, "EmployeePaySlip") = "", "", ", " &amp; First(Fields!City.Value, "EmployeePaySlip")) &amp; IIf(IsNothing(First(Fields!State.Value, "EmployeePaySlip")) Or First(Fields!State.Value, "EmployeePaySlip") = "", "", ", " &amp; First(Fields!State.Value, "EmployeePaySlip")) &amp; IIf(IsNothing(First(Fields!ZipCode.Value, "EmployeePaySlip")) Or First(Fields!ZipCode.Value, "EmployeePaySlip") = "", "", " - " &amp; First(Fields!ZipCode.Value, "EmployeePaySlip")))</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>7.5pt</FontSize>
                      <Color>#64748b</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>=IIf(First(Fields!PrimaryEmail.Value, "EmployeePaySlip") &lt;&gt; "", "Email: " &amp; First(Fields!PrimaryEmail.Value, "EmployeePaySlip"), "") &amp; IIf(First(Fields!Website.Value, "EmployeePaySlip") &lt;&gt; "", "  |  " &amp; First(Fields!Website.Value, "EmployeePaySlip"), "")</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>7.5pt</FontSize>
                      <Color>#64748b</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
            </Paragraphs>
            <Top>0.52in</Top>
            <Height>0.52in</Height>
            <Width>4.1in</Width>
            <ZIndex>1</ZIndex>
            <Style>
              <Border>
                <Style>None</Style>
              </Border>
              <PaddingTop>2pt</PaddingTop>
            </Style>
          </Textbox>
          <Textbox Name="TxtHeaderPayslipTitle">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>PAYSLIP</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>18pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <Color>#1e3a8a</Color>
